# ==========================================
# AI Health Report Translator Configuration
# ==========================================

# Environment: development | test | production
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=dev_secret_health_translator_super_secure_key_change_in_prod_2026

# Server
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8081","*"]

# Database (PostgreSQL 16 + pgvector)
POSTGRES_USER=health_user
POSTGRES_PASSWORD=health_password
POSTGRES_DB=health_translator_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://health_user:health_password@localhost:5432/health_translator_db
# In Docker Compose, the API container connects via postgres host:
# DATABASE_URL=postgresql+asyncpg://health_user:health_password@postgres:5432/health_translator_db

# Redis (Job Queue & Cache)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
# In Docker Compose:
# REDIS_URL=redis://redis:6379/0

# Object Storage (MinIO / S3 compatible)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=medical-reports
S3_REGION=us-east-1
S3_SECURE=false

# Authentication & JWT
JWT_SECRET_KEY=dev_jwt_secret_change_in_production_key_parvathi_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Phone & OTP Provider Settings
OTP_DEV_MODE=true
OTP_DEFAULT_CODE=123456
OTP_EXPIRY_SECONDS=300
MAX_OTP_ATTEMPTS=5
# Set OTP_DEV_MODE=false and OTP_PROVIDER=twilio_verify to send actual OTP SMS.
# Create a Twilio Verify service and place its credentials below. Never commit
# real values to version control.
OTP_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Set only to the E.164 phone number of the person who may create the first
# administrator account through OTP. Example: +919876543210
BOOTSTRAP_ADMIN_PHONE=

# AI Pipeline Providers (swappable behind interfaces)
# Set MOCK_PROVIDERS=true for offline local development without external credentials
MOCK_PROVIDERS=true

# OCR Provider: mock | tesseract | google_vision | azure_doc_intelligence
OCR_PROVIDER=mock
TESSERACT_PATH=tesseract

# Extraction Provider: mock | openai | gemini
EXTRACTION_PROVIDER=mock
LLM_API_KEY=

# Translation Provider: mock | bhashini | indictrans2
TRANSLATION_PROVIDER=mock
BHASHINI_USER_ID=
BHASHINI_API_KEY=
BHASHINI_INFERENCE_KEY=

# Text-to-Speech (TTS) Provider: mock | bhashini | azure | google
TTS_PROVIDER=mock
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Telephony: mock | exotel | twilio
TELEPHONY_PROVIDER=mock
EXOTEL_ACCOUNT_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_CALLER_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Telephony Simulator & Callback Base URL
TELEPHONY_WEBHOOK_BASE_URL=http://localhost:8000
