{
  "name": "ai-health-report-translator",
  "version": "1.0.0",
  "private": true,
  "description": "AI Health Report Translator monorepo for low-literacy and multilingual users across 22 scheduled Indian languages",
  "scripts": {
    "dev:web": "pnpm --filter @ai-health/web dev",
    "dev:mobile": "pnpm --filter @ai-health/mobile start",
    "build:web": "pnpm --filter @ai-health/web build",
    "test:shared": "pnpm --filter @ai-health/shared test",
    "lint": "pnpm -r lint"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  },
  "packageManager": "pnpm@10.5.0"
}
