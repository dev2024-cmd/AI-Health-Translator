        "jsCode": "let rawText = '';\nif ($json.content?.parts?.[0]?.text) {\n  rawText = $json.content.parts[0].text;\n} else if ($json.text) {\n  rawText = $json.text;\n} else {\n  rawText = JSON.stringify($json);\n}\n\nconst cleaned = rawText\n  .replace(/```json/gi, '')\n  .replace(/```/g, '')\n  .trim();\n\nlet data = {};\ntry {\n  data = JSON.parse(cleaned);\n} catch (err) {\n  data = {\n    document_type: 'lab_report',\n    patient_name: 'Patient',\n    extracted_values: []\n  };\n}\n\nreturn [\n  {\n    json: data\n  }\n];"
